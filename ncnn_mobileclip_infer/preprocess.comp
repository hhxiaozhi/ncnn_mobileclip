#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D srcImg;

layout(std430, binding = 1) writeonly buffer OutBuf {
    float data[];
} outBuf;

layout(push_constant, std430) uniform PC {
    vec4 crop[5];
    vec4 mean;
    vec4 invStd;
    vec4 reserved;
} pc;

const uint OW = 224u;
const uint OH = 224u;
const uint PLANE = OW * OH;

void main() {
    uvec3 gid = gl_GlobalInvocationID;
    if (gid.x >= OW || gid.y >= OH || gid.z >= 5u) return;

    vec4 c = pc.crop[gid.z];
    vec2 uv = c.xy + (vec2(gid.xy) + 0.5) * c.zw;

    vec3 rgb = textureLod(srcImg, uv, 0.0).rgb;
    vec3 x = (rgb - pc.mean.xyz) * pc.invStd.xyz;

    uint base = gid.z * 3u * PLANE;
    uint idx  = gid.y * OW + gid.x;
    outBuf.data[base + 0u * PLANE + idx] = x.r;
    outBuf.data[base + 1u * PLANE + idx] = x.g;
    outBuf.data[base + 2u * PLANE + idx] = x.b;
}
